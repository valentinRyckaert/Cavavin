<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cavavin</title>
    <style>
        :root {
            --oak-dark: #1e120a;
            --oak: #3b2414;
            --oak-light: #5e3b21;
            --brass: #c9a25a;
            --brass-dark: #8a6a2f;
            --parchment: #f2e4c4;
            --parchment-dark: #d9c294;
            --ink: #2b1a0e;
            --wine: #6e1a1f;
            --moss: #3f5426;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            padding: 2rem 1rem;
            font-family: "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
            color: var(--ink);
            background:
                linear-gradient(rgba(20, 10, 4, .55), rgba(20, 10, 4, .8)),
                url("/background.jpg") center / cover fixed,
                var(--oak-dark);
        }

        .container { max-width: 1100px; margin: 0 auto; }

        h1 {
            margin: 0 0 2rem;
            text-align: center;
            font-size: 2.8rem;
            font-variant: small-caps;
            letter-spacing: .08em;
            color: var(--parchment);
            text-shadow: 0 2px 0 #000, 0 0 18px rgba(201, 162, 90, .5);
        }
        h1::after {
            content: "❦";
            display: block;
            font-size: 1.4rem;
            color: var(--brass);
        }

        h2 {
            margin: 0;
            font-size: 1.25rem;
            font-variant: small-caps;
            letter-spacing: .06em;
        }

        .columns {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            column-gap: 1.5rem;
        }

        /* Panneau : cadre en chêne + filet laiton, contenu parchemin */
        .card {
            display: flex;
            flex-direction: column;
            margin-bottom: 1.5rem;
            border: 3px solid var(--oak-dark);
            border-radius: 6px;
            overflow: hidden;
            box-shadow: 0 0 0 2px var(--brass-dark), 0 12px 30px rgba(0, 0, 0, .6);
        }

        .card-header {
            padding: .8rem 1.2rem;
            color: var(--parchment);
            text-shadow: 0 1px 0 #000;
            border-bottom: 3px solid var(--brass-dark);
            /* veinage du bois */
            background:
                repeating-linear-gradient(175deg, rgba(0, 0, 0, .10) 0 2px, transparent 2px 9px, rgba(255, 255, 255, .04) 9px 11px, transparent 11px 23px),
                linear-gradient(180deg, var(--oak-light), var(--oak) 60%, var(--oak-dark));
        }

        .card-body {
            flex: 1;
            padding: 1.2rem;
            background: radial-gradient(ellipse at center, #f7ecd3 0%, #e6d2a6 100%);
        }
        .card-body p { margin-top: 0; font-style: italic; }

        .field { margin-bottom: .9rem; }

        .fields {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            column-gap: 1rem;
        }

        .inline { display: flex; gap: .6rem; align-items: flex-start; }
        .inline .field { flex: 1; margin: 0; }

        input, select {
            width: 100%;
            padding: .55rem .7rem;
            font: inherit;
            color: var(--ink);
            background: #fbf4e2;
            border: 1px solid var(--brass-dark);
            border-radius: 3px;
            box-shadow: inset 0 1px 3px rgba(0, 0, 0, .25);
        }
        select { margin-bottom: .9rem; }
        input:focus, select:focus { outline: 2px solid var(--brass); outline-offset: 1px; }

        .btn {
            padding: .5rem 1.1rem;
            font: inherit;
            font-variant: small-caps;
            letter-spacing: .05em;
            white-space: nowrap;
            color: var(--parchment);
            text-shadow: 0 1px 0 #000;
            cursor: pointer;
            border: 1px solid var(--oak-dark);
            border-radius: 3px;
            background: linear-gradient(180deg, var(--oak-light), var(--oak));
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .15), 0 2px 3px rgba(0, 0, 0, .4);
        }
        .btn:hover { filter: brightness(1.2); }
        .btn:active { transform: translateY(1px); box-shadow: inset 0 2px 4px rgba(0, 0, 0, .4); }
        .btn-add { background: linear-gradient(180deg, #56703a, var(--moss)); }
        .btn-consume { background: linear-gradient(180deg, #8c2a30, var(--wine)); }

        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th {
            padding: .6rem .7rem;
            text-align: left;
            font-variant: small-caps;
            color: var(--parchment);
            background: var(--oak);
            border-bottom: 2px solid var(--brass-dark);
        }
        td { padding: .5rem .7rem; border-bottom: 1px solid var(--parchment-dark); }
        tbody tr:nth-child(even) { background: rgba(139, 100, 50, .1); }
        td input { width: 4rem; }
    </style>
</head>
<body>
    <%= yield %>
</body>
</html>
