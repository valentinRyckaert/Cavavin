<div class="card">
  <div class="card-body table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">appearance</th>
          <th scope="col">région</th>
          <th scope="col">appellation</th>
          <th scope="col">estate</th>
          <th scope="col">année</th>
          <th scope="col">nombre de bouteilles</th>
          <th scope="col">actions</th>
        </tr>
      </thead>
      <tbody>
        <% listeVins.each do |wine| %>
          <tr>
            <td><%= h wine.appearance %></td>
            <td><%= h wine.region %></td>
            <td><%= h wine.appellation %></td>
            <td><%= h wine.estate %></td>
            <td><%= wine.vintage %></td>
            <td><%= wine.nbBottles %></td>
            <td>
              <form action="/changequantity/<%= action %>" method="post" class="inline">
                <input type="hidden" name="vinId" value="<%= wine.id %>">
                <input type="number" name="nbBottles" value="1" aria-label="Nombre de bouteilles">
                <button class="btn <%= action_button_class_and_text(action)[:class] %>" type="submit">
                  <%= action_button_class_and_text(action)[:text] %>
                </button>
              </form>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
