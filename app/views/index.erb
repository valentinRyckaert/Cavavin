<div class="container">
    <h1>Ma Cave à Vin</h1>
    <div class="columns">
        <!-- Colonne gauche : Consommation d'un vin -->
        <div class="card">
            <div class="card-header">
                <h2>Consommer un vin</h2>
            </div>
            <div class="card-body">
                <form action="/search/consume" method="get">
                    <select name="searchType" aria-label="Critère de recherche">
                        <option value="appellation" selected>rechercher l'appellation</option>
                        <option value="appearance">rechercher la appearance</option>
                        <option value="region">rechercher la région</option>
                        <option value="estate">rechercher le estate</option>
                    </select>
                    <div class="inline">
                        <%= erb :'_input_field', locals: { name: "query", placeholder: "Rechercher une bouteille...", required: true } %>
                        <button class="btn" type="submit">Rechercher</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Colonne droite : Ajouter un vin -->
        <div class="card">
            <div class="card-header">
                <h2>Ajouter une bouteille</h2>
            </div>
            <div class="card-body">
                <form action="/search/add" method="get">
                    <%= erb :'_input_field', locals: { name: "appellation", placeholder: "Rentrer l'appellation de la bouteille...", required: true } %>
                    <%= erb :'_input_field', locals: { name: "vintage", type: "number", placeholder: "Rentrer l'année de la bouteille...", required: true } %>
                    <button class="btn" type="submit">Rechercher</button>
                </form>
            </div>
        </div>
    </div>

    <% if listeVins != nil %>
        <%= erb :'_winelist', locals: { listeVins: listeVins, action: action } %>
    <% end %>
    <% if action === 'add' %>
        <%= erb :'_addwine', locals: { nouveauVin: nouveauVin } %>
    <% end %>
</div>
