<div class="field">
  <input
    type="<%= defined?(type) ? type : 'text' %>"
    name="<%= name %>"
    placeholder="<%= h placeholder %>"
    aria-label="<%= h placeholder %>"
    <%= defined?(value) ? 'value="' + h(value) + '"' : '' %>
    <%= defined?(required) ? 'required' : '' %>
    <%= defined?(min) ? 'min="' + min.to_s + '"' : '' %>
  >
</div>
